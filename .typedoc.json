{
  "$schema": "https://typedoc.org/schema.json",
  "_metadata": {
    "project": "PranaKaia E-Commerce",
    "role": "TypeDoc Reference",
    "tier": "Absolute Zero (S+)",
    "compliance": "SOTA Absolute Zero"
  },
  "name": "💎 PranaKaia API Reference",
  "entryPoints": [
    "packages/shared-kernel/src/index.ts",
    "packages/cart/src/index.ts",
    "packages/catalog/src/index.ts",
    "packages/checkout/src/index.ts",
    "packages/inventory/src/index.ts",
    "packages/pricing/src/index.ts",
    "packages/payments/src/index.ts",
    "packages/shipping/src/index.ts",
    "packages/supplier/src/index.ts",
    "packages/logistics/src/index.ts",
    "packages/communications/src/index.ts",
    "packages/identity/src/index.ts",
    "packages/application/src/index.ts",
    "packages/infrastructure/src/index.ts",
    "packages/testkit/src/index.ts"
  ],
  "out": "docs/api",
  "exclude": ["**/node_modules/**", "**/dist/**", "**/*.test.*", "**/__tests__/**", "**/*.spec.*"],
  "excludePrivate": true,
  "excludeProtected": false,
  "excludeExternals": true,
  "includeVersion": true,
  "readme": "README.md",
  "plugin": [],
  "tsconfig": "tsconfig.json",
  "entryPointStrategy": "packages",
  "excludeInternal": true,
  "categorizeByGroup": true,
  "groupOrder": [
    "Entities",
    "Value Objects",
    "Events",
    "Ports",
    "Use Cases",
    "Commands",
    "Queries",
    "Services",
    "Types",
    "Interfaces",
    "Classes",
    "Functions",
    "Variables",
    "Constants",
    "*"
  ],
  "categorize": {
    "Entities": ["*Entity*", "*Aggregate*"],
    "Value Objects": ["*ValueObject*", "*VO*"],
    "Events": ["*Event*", "*DomainEvent*"],
    "Ports": ["*Port*", "*Repository*", "*Service*"],
    "Use Cases": ["*UseCase*", "*Command*", "*Query*"]
  }
}
