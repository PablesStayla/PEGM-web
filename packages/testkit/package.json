{
  "name": "@pranakaia/testkit",
  "version": "1.0.0",
  "description": "Testing utilities - Factories, fixtures, e2e helpers",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "attw": "attw --pack .",
    "publint": "publint"
  },
  "dependencies": {
    "@faker-js/faker": "^8.0.0",
    "@pranakaia/shared-kernel": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "@types/node": "^24.0.0",
    "ioredis": "^5.10.1",
    "publint": "^0.3.8",
    "tsup": "^8.4.0",
    "typescript": "5.6.3"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}
