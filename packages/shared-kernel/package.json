{
  "name": "@pranakaia/shared-kernel",
  "version": "2.0.0",
  "type": "module",
  "description": "Shared Kernel — Base types, Result pattern, Branded Types, Value Object base, DomainError. Zero framework dependencies.",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ],
      "result": [
        "./dist/domain/result.d.ts"
      ],
      "branded": [
        "./dist/branded.d.ts"
      ],
      "entity": [
        "./dist/domain/entity.d.ts"
      ],
      "value-object": [
        "./dist/domain/value-object.d.ts"
      ],
      "domain-error": [
        "./dist/domain-error.d.ts"
      ],
      "events": [
        "./dist/events.d.ts"
      ],
      "option": [
        "./dist/domain/option.d.ts"
      ],
      "aggregate-root": [
        "./dist/domain/aggregate-root.d.ts"
      ],
      "repository-port": [
        "./dist/domain/repository.port.d.ts"
      ],
      "event-bus-port": [
        "./dist/domain/event-bus.port.d.ts"
      ],
      "use-case": [
        "./dist/application/use-case.d.ts"
      ],
      "command": [
        "./dist/application/command.d.ts"
      ],
      "query": [
        "./dist/application/query.d.ts"
      ],
      "application": [
        "./dist/application/index.d.ts"
      ],
      "domain": [
        "./dist/domain/index.d.ts"
      ],
      "utils": [
        "./dist/utils.d.ts"
      ],
      "safe-integer": [
        "./dist/domain/safe-integer.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./result": {
      "import": {
        "types": "./dist/domain/result.d.ts",
        "default": "./dist/domain/result.js"
      },
      "require": {
        "types": "./dist/domain/result.d.cts",
        "default": "./dist/domain/result.cjs"
      }
    },
    "./branded": {
      "import": {
        "types": "./dist/branded.d.ts",
        "default": "./dist/branded.js"
      },
      "require": {
        "types": "./dist/branded.d.cts",
        "default": "./dist/branded.cjs"
      }
    },
    "./entity": {
      "import": {
        "types": "./dist/domain/entity.d.ts",
        "default": "./dist/domain/entity.js"
      },
      "require": {
        "types": "./dist/domain/entity.d.cts",
        "default": "./dist/domain/entity.cjs"
      }
    },
    "./value-object": {
      "import": {
        "types": "./dist/domain/value-object.d.ts",
        "default": "./dist/domain/value-object.js"
      },
      "require": {
        "types": "./dist/domain/value-object.d.cts",
        "default": "./dist/domain/value-object.cjs"
      }
    },
    "./domain-error": {
      "import": {
        "types": "./dist/domain-error.d.ts",
        "default": "./dist/domain-error.js"
      },
      "require": {
        "types": "./dist/domain-error.d.cts",
        "default": "./dist/domain-error.cjs"
      }
    },
    "./events": {
      "import": {
        "types": "./dist/events.d.ts",
        "default": "./dist/events.js"
      },
      "require": {
        "types": "./dist/events.d.cts",
        "default": "./dist/events.cjs"
      }
    },
    "./option": {
      "import": {
        "types": "./dist/domain/option.d.ts",
        "default": "./dist/domain/option.js"
      },
      "require": {
        "types": "./dist/domain/option.d.cts",
        "default": "./dist/domain/option.cjs"
      }
    },
    "./aggregate-root": {
      "import": {
        "types": "./dist/domain/aggregate-root.d.ts",
        "default": "./dist/domain/aggregate-root.js"
      },
      "require": {
        "types": "./dist/domain/aggregate-root.d.cts",
        "default": "./dist/domain/aggregate-root.cjs"
      }
    },
    "./repository-port": {
      "import": {
        "types": "./dist/domain/repository.port.d.ts",
        "default": "./dist/domain/repository.port.js"
      },
      "require": {
        "types": "./dist/domain/repository.port.d.cts",
        "default": "./dist/domain/repository.port.cjs"
      }
    },
    "./event-bus-port": {
      "import": {
        "types": "./dist/domain/event-bus.port.d.ts",
        "default": "./dist/domain/event-bus.port.js"
      },
      "require": {
        "types": "./dist/domain/event-bus.port.d.cts",
        "default": "./dist/domain/event-bus.port.cjs"
      }
    },
    "./use-case": {
      "import": {
        "types": "./dist/application/use-case.d.ts",
        "default": "./dist/application/use-case.js"
      },
      "require": {
        "types": "./dist/application/use-case.d.cts",
        "default": "./dist/application/use-case.cjs"
      }
    },
    "./command": {
      "import": {
        "types": "./dist/application/command.d.ts",
        "default": "./dist/application/command.js"
      },
      "require": {
        "types": "./dist/application/command.d.cts",
        "default": "./dist/application/command.cjs"
      }
    },
    "./query": {
      "import": {
        "types": "./dist/application/query.d.ts",
        "default": "./dist/application/query.js"
      },
      "require": {
        "types": "./dist/application/query.d.cts",
        "default": "./dist/application/query.cjs"
      }
    },
    "./application": {
      "import": {
        "types": "./dist/application/index.d.ts",
        "default": "./dist/application/index.js"
      },
      "require": {
        "types": "./dist/application/index.d.cts",
        "default": "./dist/application/index.cjs"
      }
    },
    "./domain": {
      "import": {
        "types": "./dist/domain/index.d.ts",
        "default": "./dist/domain/index.js"
      },
      "require": {
        "types": "./dist/domain/index.d.cts",
        "default": "./dist/domain/index.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils.d.ts",
        "default": "./dist/utils.js"
      },
      "require": {
        "types": "./dist/utils.d.cts",
        "default": "./dist/utils.cjs"
      }
    },
    "./safe-integer": {
      "import": {
        "types": "./dist/domain/safe-integer.d.ts",
        "default": "./dist/domain/safe-integer.js"
      },
      "require": {
        "types": "./dist/domain/safe-integer.d.cts",
        "default": "./dist/domain/safe-integer.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist .turbo tsconfig.tsbuildinfo",
    "type-check": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "attw": "attw --pack .",
    "publint": "publint",
    "typedoc": "typedoc --options ../../typedoc.json src/index.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "publint": "^0.3.8",
    "tsup": "^8.4.0",
    "typedoc": "^0.27.9",
    "@types/node": "^24.0.0",
    "typescript": "5.6.3",
    "vitest": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0"
  },
  "files": [
    "dist",
    "src",
    "!**/*.test.*",
    "!**/__tests__/**"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}
