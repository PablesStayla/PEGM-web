{
  "name": "@pranakaia/core-building-blocks",
  "version": "1.0.0",
  "type": "module",
  "description": "Core DDD Building Blocks - Base classes (AggregateRoot, Entity, ValueObject, DomainEvent) for the PranaKaia ecosystem",
  "sideEffects": [
    "src/result-extensions.ts",
    "dist/**/*.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "clean": "rimraf dist .turbo",
    "attw": "attw --pack .",
    "publint": "publint"
  },
  "dependencies": {
    "@pranakaia/shared-kernel": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "publint": "^0.3.8",
    "tsup": "^8.4.0",
    "@types/node": "^24.0.0",
    "typescript": "5.6.3",
    "vitest": "^4.1.0"
  },
  "files": [
    "dist",
    "src",
    "!**/*.test.*",
    "!**/__tests__/**"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}
