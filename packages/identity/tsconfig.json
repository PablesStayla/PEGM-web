{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "composite": false,
    "declaration": true,
    "declarationMap": true,
    "types": ["node", "vitest/globals"],
    "lib": ["ESNext"],
    "baseUrl": ".",
    "paths": {
      "@pranakaia/identity": ["./src/index.ts"],
      "@pranakaia/identity/*": ["./src/*"],
      "@pranakaia/shared-kernel": ["../shared-kernel/src/index.ts"],
      "@pranakaia/infrastructure/*": ["../infrastructure/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
