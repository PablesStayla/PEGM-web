{
  "name": "@pranakaia/identity",
  "version": "1.0.0",
  "type": "module",
  "description": "Identity Bounded Context - Authentication, authorization, Better Auth + Supabase integration",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ],
      "auth": [
        "./dist/auth/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./auth": {
      "import": {
        "types": "./dist/auth/index.d.ts",
        "default": "./dist/auth/index.js"
      },
      "require": {
        "types": "./dist/auth/index.d.cts",
        "default": "./dist/auth/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "clean": "rimraf dist .turbo tsconfig.tsbuildinfo",
    "attw": "attw --pack .",
    "publint": "publint",
    "typedoc": "typedoc --options ../../typedoc.json src/index.ts"
  },
  "dependencies": {
    "@pranakaia/db": "workspace:*",
    "@pranakaia/domain": "workspace:*",
    "@pranakaia/shared-kernel": "workspace:*",
    "@supabase/supabase-js": "^2.48.1",
    "argon2": "^0.41.1",
    "better-auth": "^1.1.18",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.10.1",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "publint": "^0.3.8",
    "tsup": "^8.4.0",
    "typedoc": "^0.27.9",
    "typescript": "5.6.3",
    "vitest": "^4.1.0"
  },
  "files": [
    "dist",
    "src",
    "!**/*.test.*",
    "!**/__tests__/**"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}
