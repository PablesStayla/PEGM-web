{
  "extends": "../config/tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "incremental": false,
    "composite": false,
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@pranakaia/payments": ["./src/index.ts"],
      "@pranakaia/payments/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.*", "**/__tests__/**"]
}
