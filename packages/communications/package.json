{
  "name": "@pranakaia/communications",
  "version": "1.0.0",
  "type": "module",
  "description": "Communications Bounded Context - Email, SMS, notifications via Resend",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "clean": "rimraf dist .turbo tsconfig.tsbuildinfo",
    "attw": "attw --pack .",
    "publint": "publint",
    "typedoc": "typedoc --options ../../typedoc.json src/index.ts"
  },
  "dependencies": {
    "@pranakaia/shared-kernel": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "publint": "^0.3.8",
    "tsup": "^8.4.0",
    "typedoc": "^0.27.9",
    "@types/node": "^24.0.0",
    "typescript": "5.6.3",
    "vitest": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0"
  },
  "files": [
    "dist",
    "src",
    "!**/*.test.*",
    "!**/__tests__/**"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}
