{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "composite": false,
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@pranakaia/catalog": ["./src/index.ts"],
      "@pranakaia/catalog/*": ["./src/*"]
    },
    "incremental": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.*", "**/__tests__/**"]
}
