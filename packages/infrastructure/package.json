{
  "name": "@pranakaia/infrastructure",
  "version": "1.0.0",
  "type": "module",
  "description": "Infrastructure Layer — Stub package (code moved to dedicated packages)",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./db": {
      "import": {
        "types": "./dist/db/index.d.ts",
        "default": "./dist/db/index.js"
      },
      "require": {
        "types": "./dist/db/index.d.cts",
        "default": "./dist/db/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "clean": "rimraf dist .turbo tsconfig.tsbuildinfo",
    "attw": "attw --pack .",
    "publint": "publint"
  },
  "dependencies": {
    "@pranakaia/db": "workspace:*",
    "@pranakaia/shared-kernel": "workspace:*",
    "@pranakaia/domain": "workspace:*",
    "@pranakaia/checkout": "workspace:*",
    "@pranakaia/inventory": "workspace:*",
    "@pranakaia/catalog": "workspace:*",
    "@pranakaia/payments": "workspace:*",
    "@pranakaia/shipping": "workspace:*",
    "@pranakaia/cart": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "otpauth": "^9.5.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "publint": "^0.3.8",
    "tsup": "^8.4.0",
    "typescript": "5.6.3",
    "vitest": "^4.1.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}
