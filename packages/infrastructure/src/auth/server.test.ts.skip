import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';

const mockCookies = vi.hoisted(() => vi.fn());
const mockGetUser = vi.hoisted(() => vi.fn());
const mockGetSession = vi.hoisted(() => vi.fn());
const mockCreateServerClient = vi.hoisted(() =>
  vi.fn(() => ({
    auth: {
      getUser: mockGetUser,
      getSession: mockGetSession,
    },
  })),
);
const mockCreateSupabaseAdminClient = vi.hoisted(() => vi.fn(() => ({ ok: true })));

vi.mock('@supabase/ssr', () => ({
  createServerClient: mockCreateServerClient,
}));

vi.mock('@supabase/supabase-js', () => ({
  createClient: mockCreateSupabaseAdminClient,
}));

vi.mock('next/headers', () => ({
  cookies: mockCookies,
}));

function createCookieStore() {
  return {
    getAll: vi.fn(() => []),
    set: vi.fn(),
    get: vi.fn(() => undefined),
  };
}

describe('auth/server', () => {
  beforeEach(() => {
    vi.resetModules();
    vi.clearAllMocks();

    vi.stubEnv('NEXT_PUBLIC_SUPABASE_URL', 'https://test.supabase.co');
    vi.stubEnv('NEXT_PUBLIC_SUPABASE_ANON_KEY', 'anon-test-key');
    vi.stubEnv('NODE_ENV', 'test');
    vi.stubEnv('ENABLE_LOCAL_ADMIN_BYPASS', 'false');

    mockCookies.mockResolvedValue(createCookieStore());
    mockGetUser.mockResolvedValue({ data: { user: null } });
    mockGetSession.mockResolvedValue({ data: { session: null } });
  });

  afterEach(() => {
    vi.unstubAllEnvs();
  });

  it('expone helpers de auth del servidor', async () => {
    const authServer = await import('../server');

    expect(typeof authServer.createClient).toBe('function');
    expect(typeof authServer.getCurrentUser).toBe('function');
    expect(typeof authServer.getCurrentSession).toBe('function');
    expect(typeof authServer.requireAuth).toBe('function');
    expect(typeof authServer.requireAdmin).toBe('function');
    expect(typeof authServer.isAdmin).toBe('function');
  });

  it('ignora bypass local y requiere usuario admin real', async () => {
    vi.stubEnv('NODE_ENV', 'development');
    vi.stubEnv('ENABLE_LOCAL_ADMIN_BYPASS', 'true');

    const { requireAdmin } = await import('../server');
    await expect(requireAdmin()).rejects.toThrow('Unauthorized: login required');
  });

  it('createClient no falla si cookies() lanza fuera de contexto Next.js', async () => {
    mockCookies.mockRejectedValueOnce(new Error('outside next context'));

    const { createClient } = await import('../server');
    const client = await createClient();

    expect(client).toBeTruthy();
    expect(mockCreateServerClient).toHaveBeenCalledTimes(1);
  });

  it('createClient usa adapters seguros cuando no hay cookieStore', async () => {
    mockCookies.mockRejectedValueOnce(new Error('outside next context'));

    const { createClient } = await import('../server');
    await createClient();

    expect(mockCreateServerClient).toHaveBeenCalled();
    const firstCall = mockCreateServerClient.mock.calls[0] as unknown[] | undefined;
    expect(firstCall).toBeDefined();
    const options = firstCall?.[2] as
      | {
          cookies: {
            getAll: () => unknown[];
            setAll: (
              cookiesToSet: Array<{ name: string; value: string; options?: unknown }>,
            ) => void;
          };
        }
      | undefined;

    expect(options).toBeDefined();
    if (!options) {
      throw new Error('Expected createServerClient options to be defined');
    }

    expect(options.cookies.getAll()).toEqual([]);
    expect(() =>
      options.cookies.setAll([{ name: 'sb-test', value: 'token', options: { path: '/' } }]),
    ).not.toThrow();
  });

  it('createClient expone adapters de cookies cuando existe cookieStore', async () => {
    const cookieStore = createCookieStore();
    mockCookies.mockResolvedValue(cookieStore);

    const { createClient } = await import('../server');
    await createClient();

    expect(mockCreateServerClient).toHaveBeenCalled();
    const firstCall = mockCreateServerClient.mock.calls[0] as unknown[] | undefined;
    expect(firstCall).toBeDefined();
    const options = firstCall?.[2] as
      | {
          cookies: {
            getAll: () => unknown[];
            setAll: (
              cookiesToSet: Array<{ name: string; value: string; options?: unknown }>,
            ) => void;
          };
        }
      | undefined;
    expect(options).toBeDefined();
    if (!options) {
      throw new Error('Expected createServerClient options to be defined');
    }

    const cookieOptions = options as {
      cookies: {
        getAll: () => unknown[];
        setAll: (cookiesToSet: Array<{ name: string; value: string; options?: unknown }>) => void;
      };
    };

    expect(cookieOptions.cookies.getAll()).toEqual([]);
    cookieOptions.cookies.setAll([{ name: 'sb-test', value: 'token', options: { path: '/' } }]);
    expect(cookieStore.set).toHaveBeenCalled();
  });

  it('createAdminClient falla sin service role key', async () => {
    Reflect.deleteProperty(process.env, 'SUPABASE_SERVICE_ROLE_KEY');

    const { createAdminClient } = await import('../server');
    await expect(createAdminClient()).rejects.toThrow('MISSING_SERVICE_ROLE');
  });

  it('createAdminClient crea cliente admin cuando hay service role key', async () => {
    vi.stubEnv('SUPABASE_SERVICE_ROLE_KEY', 'service-role-key');

    const { createAdminClient } = await import('../server');
    const client = await createAdminClient();

    expect(client).toEqual({ ok: true });
    expect(mockCreateSupabaseAdminClient).toHaveBeenCalledTimes(1);
  });

  it('requireAuth falla cuando no hay usuario autenticado', async () => {
    const { requireAuth } = await import('../server');

    await expect(requireAuth()).rejects.toThrow('Unauthorized: authentication required');
  });

  it('requireAuth retorna usuario cuando existe sesión', async () => {
    mockGetUser.mockResolvedValueOnce({
      data: {
        user: {
          id: 'user-2',
          email: 'user2@pranakaia.com',
          user_metadata: { role: 'CUSTOMER' },
        },
      },
    });

    const { requireAuth } = await import('../server');
    const user = await requireAuth();

    expect(user.id).toBe('user-2');
  });

  it('getCurrentSession retorna sesión del cliente de auth', async () => {
    mockGetSession.mockResolvedValueOnce({ data: { session: { id: 'session-1' } } });

    const { getCurrentSession } = await import('../server');
    const session = await getCurrentSession();

    expect(session).toEqual({ id: 'session-1' });
  });

  it('rechaza acceso cuando usuario no tiene rol admin', async () => {
    mockGetUser.mockResolvedValue({
      data: {
        user: {
          id: 'user-1',
          email: 'user@pranakaia.com',
          user_metadata: { role: 'CUSTOMER' },
        },
      },
    });

    const { requireAdmin } = await import('../server');

    await expect(requireAdmin()).rejects.toThrow('Forbidden: admin access required');
  });

  it('acepta usuarios con rol ADMIN', async () => {
    mockGetUser.mockResolvedValue({
      data: {
        user: {
          id: 'admin-1',
          email: 'admin@pranakaia.com',
          user_metadata: { role: 'ADMIN' },
        },
      },
    });

    const { requireAdmin } = await import('../server');
    const user = await requireAdmin();

    expect(user.id).toBe('admin-1');
  });

  it('isAdmin retorna false sin usuario y true para SUPER_ADMIN', async () => {
    const { isAdmin } = await import('../server');

    expect(await isAdmin()).toBe(false);

    mockGetUser.mockResolvedValueOnce({
      data: {
        user: {
          id: 'super-admin-1',
          email: 'super@pranakaia.com',
          user_metadata: { role: 'SUPER_ADMIN' },
        },
      },
    });

    expect(await isAdmin()).toBe(true);
  });
});
