import { Secret, TOTP } from 'otpauth';
import { describe, expect, it } from 'vitest';
import {
  generate2FASecret,
  generateBackupCodes,
  hashBackupCode,
  verify2FAToken,
  verifyBackupCode,
} from './two-factor';

describe('two-factor helpers', () => {
  it('genera un secreto utilizable y valida un token TOTP real', async () => {
    const email = 'security@pranakaia.com';
    const { secret, qrCode } = await generate2FASecret(email, 'PranaKaia Admin');

    expect(secret.base32).toBeTruthy();
    expect(secret.otpauth_url).toContain('otpauth://totp/');
    expect(qrCode).toContain('data:image/png;base64,');

    const totp = new TOTP({
      issuer: 'PranaKaia Admin',
      label: email,
      secret: Secret.fromBase32(secret.base32),
    });

    const token = totp.generate();
    expect(await verify2FAToken(token, secret.base32, email)).toBe(true);
    expect(await verify2FAToken('000000', secret.base32, email)).toBe(false);
  });

  it('genera y verifica backup codes hasheados', async () => {
    const backupCodes = generateBackupCodes(3);
    const hashedCodes = await Promise.all(backupCodes.map((code) => hashBackupCode(code)));

    expect(backupCodes).toHaveLength(3);
    const firstCode = backupCodes[0];
    if (!firstCode) {
      throw new Error('Expected at least one backup code');
    }
    expect(await verifyBackupCode(firstCode, hashedCodes)).toBe(true);
    expect(await verifyBackupCode('FFFF-FFFF', hashedCodes)).toBe(false);
  });
});
