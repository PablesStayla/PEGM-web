import { NextRequest } from 'next/server';
import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';

const mockGetUser = vi.hoisted(() => vi.fn());
const mockCreateServerClient = vi.hoisted(() =>
  vi.fn(() => ({
    auth: {
      getUser: mockGetUser,
    },
  })),
);

vi.mock('@supabase/ssr', () => ({
  createServerClient: mockCreateServerClient,
}));

function createRequest(url: string, cookies: Record<string, string> = {}) {
  const request = new NextRequest(url);

  for (const [name, value] of Object.entries(cookies)) {
    request.cookies.set(name, value);
  }

  return request;
}

describe('auth/middleware updateSession', () => {
  beforeEach(() => {
    vi.resetModules();
    vi.clearAllMocks();

    vi.stubEnv('NEXT_PUBLIC_SUPABASE_URL', 'https://test.supabase.co');
    vi.stubEnv('NEXT_PUBLIC_SUPABASE_ANON_KEY', 'anon-test-key');
    vi.stubEnv('ENABLE_LOCAL_ADMIN_BYPASS', 'false');
    vi.stubEnv('NODE_ENV', 'test');

    mockGetUser.mockResolvedValue({ data: { user: null } });
  });

  afterEach(() => {
    vi.unstubAllEnvs();
  });

  it('permite bypass local solo en localhost cuando está habilitado en desarrollo', async () => {
    vi.stubEnv('NODE_ENV', 'development');
    vi.stubEnv('ENABLE_LOCAL_ADMIN_BYPASS', 'true');

    const { updateSession } = await import('../middleware');
    const response = await updateSession(
      createRequest('http://localhost/dashboard', {
        'pk-admin-local': 'true',
      }),
    );

    expect(response.status).toBe(200);
    expect(response.headers.get('location')).toBeNull();
  });

  it('bloquea bypass local en producción aunque exista cookie de bypass', async () => {
    vi.stubEnv('NODE_ENV', 'production');
    vi.stubEnv('ENABLE_LOCAL_ADMIN_BYPASS', 'true');

    const { updateSession } = await import('../middleware');
    const response = await updateSession(
      createRequest('http://localhost/dashboard', {
        'pk-admin-local': 'true',
      }),
    );

    expect(response.status).toBe(307);
    expect(response.headers.get('location')).toContain('/login');
  });

  it('bloquea bypass cuando el host no es loopback aunque esté en desarrollo', async () => {
    vi.stubEnv('NODE_ENV', 'development');
    vi.stubEnv('ENABLE_LOCAL_ADMIN_BYPASS', 'true');

    const { updateSession } = await import('../middleware');
    const response = await updateSession(
      createRequest('http://admin.pranakaia.local/dashboard', {
        'pk-admin-local': 'true',
      }),
    );

    expect(response.status).toBe(307);
    expect(response.headers.get('location')).toContain('/login');
  });
});
