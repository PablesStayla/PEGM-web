{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,

    "allowJs": false,
    "checkJs": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,

    "module": "ESNext",
    "moduleResolution": "bundler",

    "baseUrl": "..",
  "paths": {
    "@pranakaia/config": ["packages/config/src"],
    "@pranakaia/config/*": ["packages/config/src/*"],
    "@pranakaia/domain": ["packages/domain/src"],
    "@pranakaia/domain/*": ["packages/domain/src/*"],
    "@pranakaia/application": ["packages/application/src"],
    "@pranakaia/application/*": ["packages/application/src/*"],
    "@pranakaia/infrastructure": ["packages/infrastructure/src"],
    "@pranakaia/infrastructure/*": ["packages/infrastructure/src/*"],
    "@pranakaia/shared-kernel": ["packages/shared-kernel/src"],
    "@pranakaia/shared-kernel/*": ["packages/shared-kernel/src/*"],
    "@pranakaia/identity": ["packages/identity/src"],
    "@pranakaia/identity/*": ["packages/identity/src/*"],
    "@pranakaia/testkit": ["packages/testkit/src"],
    "@pranakaia/ui": ["packages/ui/src"],
    "@pranakaia/ui/*": ["packages/ui/src/*"]
  },

    "useUnknownInCatchVariables": true
  },
  "exclude": ["node_modules", ".next", "dist", "build", "coverage", ".turbo", ".vercel"]
}
