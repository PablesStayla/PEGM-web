{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "name": "🚀 PranaKaia Deployment Engine",
  "_metadata": {
    "project": "PranaKaia E-Commerce",
    "role": "Deployment Orchestration",
    "tier": "Absolute Zero (S+)",
    "compliance": "SOTA Platinum Standard",
    "icons": {
      "framework": "⚛️",
      "build": "🏗️",
      "headers": "🛡️",
      "routing": "🛣️"
    },
    "lastUpdated": "2026-05-05"
  },
  "framework": "nextjs",
  "buildCommand": "pnpm turbo build --filter=@pranakaia/web",
  "outputDirectory": "apps/web/.next",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocations=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
