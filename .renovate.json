{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "PranaKaia Enterprise Dependency Automation Standard",
  "_metadata": {
    "project": "PranaKaia E-Commerce",
    "role": "Dependency Lifecycle Automation",
    "tier": "Absolute Zero (S+)",
    "compliance": "SOTA Catalog Integrity",
    "icons": {
      "automation": "🤖",
      "security": "🛡️",
      "updates": "🔄",
      "dashboard": "📊"
    },
    "lastUpdated": "2026-05-05"
  },
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    ":maintainLockFilesMonthly"
  ],
  "rangeStrategy": "bump",
  "labels": ["dependencies", "renovate"],
  "schedule": ["before 9am on monday"],
  "timezone": "America/Santiago",
  "prHourlyLimit": 5,
  "prConcurrentLimit": 10,
  "reviewers": ["PablesStayla"],
  "assignees": ["PablesStayla"],
  "baseBranches": ["main"],
  "branchConcurrentLimit": 5,
  "gitAuthor": "Renovate Bot <renovate@pranakaia.cl>",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "labels": ["dependencies", "auto-merge"]
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major"],
      "reviewers": ["PablesStayla"]
    },
    {
      "groupName": "React ecosystem",
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"]
    },
    {
      "groupName": "Next.js ecosystem",
      "matchPackageNames": ["next", "eslint-config-next"]
    },
    {
      "groupName": "TypeScript toolchain",
      "matchPackageNames": ["typescript", "@types/node", "@types/**"]
    },
    {
      "groupName": "Database tools",
      "matchPackageNames": ["drizzle-orm", "drizzle-kit", "@supabase/**"]
    },
    {
      "groupName": "Testing tools",
      "matchPackageNames": ["vitest", "@vitest/**", "playwright", "@playwright/**"]
    },
    {
      "groupName": "UI components",
      "matchPackageNames": ["@radix-ui/**", "@shadcn/**", "lucide-react"]
    },
    {
      "matchPackageNames": ["node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchPackageNames": ["pnpm"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "vulnerability"],
    "automerge": false
  },
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "📊 Dependency Dashboard",
  "dependencyDashboardAutoclose": true
}
