{
  "$schema": "https://opencode.ai/config.json",
  "name": "💎 PranaKaia E-Commerce Platform (Enterprise)",
  "model": "anthropic/claude-3-5-sonnet-latest",
  "small_model": "anthropic/claude-3-haiku-latest",
  "autoupdate": true,
  "shell": "powershell",
  "logLevel": "INFO",
  "instructions": [
    "AGENTS.md",
    "docs/context/architecture-overview.md",
    "docs/domain/RULES.md",
    "docs/policies/coding-standard.md"
  ],
  "permission": {
    "edit": "allow",
    "bash": "ask",
    "webfetch": "allow",
    "postgres_*": "ask",
    "stripe_*": "ask",
    "github_*": "ask"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "oauth": {},
      "enabled": true
    },
    "mcp_everything": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-everything"],
      "enabled": false
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem@latest", "."],
      "enabled": true,
      "description": "📂 Secure Local Workspace Access"
    },
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres@latest"],
      "environment": {
        "DATABASE_URL": "{env:DATABASE_URL}"
      },
      "enabled": true,
      "description": "🐘 Real-time Database Operations (PostgreSQL)"
    },
    "upstash": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/mcp@latest"],
      "environment": {
        "UPSTASH_REDIS_REST_URL": "{env:UPSTASH_REDIS_REST_URL}",
        "UPSTASH_REDIS_REST_TOKEN": "{env:UPSTASH_REDIS_REST_TOKEN}"
      },
      "enabled": true,
      "description": "⚡ High-speed Cache & Session Management (Upstash)"
    },
    "redis": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-redis@latest"],
      "environment": {
        "REDIS_URL": "{env:REDIS_URL}"
      },
      "enabled": true,
      "description": "🔴 Distributed Messaging & State (Redis)"
    },
    "vercel": {
      "type": "local",
      "command": ["npx", "-y", "vercel@latest"],
      "environment": {
        "VERCEL_TOKEN": "{env:VERCEL_TOKEN}"
      },
      "enabled": true,
      "description": "▲ Deployment & Cloud Infrastructure Orchestration"
    },
    "shell": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-shell@latest"],
      "enabled": true,
      "description": "🐚 Advanced System Shell Access"
    },
    "supabase": {
      "type": "local",
      "command": ["npx", "-y", "@supabase/mcp-server-supabase@latest"],
      "environment": {
        "SUPABASE_ACCESS_TOKEN": "{env:SUPABASE_ACCESS_TOKEN}",
        "SUPABASE_URL": "{env:SUPABASE_URL}"
      },
      "enabled": true,
      "description": "🔥 BaaS Operations & Authentication Control"
    },
    "stripe": {
      "type": "local",
      "command": ["npx", "-y", "@stripe/mcp@latest"],
      "environment": {
        "STRIPE_SECRET_KEY": "{env:STRIPE_SECRET_KEY}"
      },
      "enabled": true,
      "description": "💳 Global Payment Infrastructure (Stripe)"
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      },
      "enabled": true,
      "description": "🐙 VCS & Collaboration Platform (GitHub)"
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "playwright-mcp"],
      "enabled": true,
      "description": "🎭 Automated E2E Testing & Browser Simulation"
    },
    "resend": {
      "type": "local",
      "command": ["npx", "-y", "resend-mcp"],
      "environment": {
        "RESEND_API_KEY": "{env:RESEND_API_KEY}"
      },
      "enabled": true,
      "description": "📧 Transactional Email Delivery (Resend)"
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true,
      "description": "🧠 Advanced Logical Reasoning & Chain-of-Thought"
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true,
      "description": "💾 Long-term Project Knowledge Retention"
    },
    "fetch": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-fetch"],
      "enabled": true,
      "description": "🌐 Global Web Access & Data Retrieval"
    },
    "docker": {
      "type": "local",
      "command": ["npx", "-y", "mcp-server-docker@latest"],
      "enabled": true,
      "description": "🐳 Containerized Environment Management"
    },
    "kubernetes": {
      "type": "local",
      "command": ["npx", "-y", "mcp-server-kubernetes"],
      "enabled": true,
      "description": "☸️ Cloud Native Orchestration (K8s)"
    }
  }
}
