{
  "_metadata": {
    "project": "PranaKaia E-Commerce",
    "role": "Release & Versioning Orchestration",
    "tier": "Absolute Zero (S+)",
    "compliance": "SOTA Platinum Standard",
    "icons": {
      "git": "🗃️",
      "npm": "📦",
      "hooks": "⚓",
      "release": "🚀"
    },
    "lastUpdated": "2026-05-05"
  },
  "git": {
    "commitMessage": "chore(release): release ${version}",
    "tagMessage": "chore(release): tag ${version}",
    "tagName": "v${version}"
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": {
        "name": "conventionalcommits"
      },
      "infile": "CHANGELOG.md",
      "header": "# Changelog\n\nAll notable changes to this project will be documented in this file.\n\nThe format is based on [Keep a Changelog](https://keepachangelog.com/en/1.1.0/),\nand this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0.html).",
      "infile": "CHANGELOG.md"
    }
  },
  "npm": {
    "publish": false
  },
  "hooks": {
    "before:init": ["pnpm lint", "pnpm type-check", "pnpm test"],
    "after:bump": "pnpm build",
    "after:release": "echo 'Successfully released ${releaseName}'"
  }
}
