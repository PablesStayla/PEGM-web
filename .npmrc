# =============================================================================
# 📦 PranaKaia Enterprise Package Registry - Absolute Zero SOTA Standard
# =============================================================================
# Project: PranaKaia E-Commerce Platform
# Role: Dependency Governance & Registry Orchestration
# Tier: Absolute Zero (S+)
# Compliance: SOTA Absolute Zero
# Last Updated: 2026-05-05
# =============================================================================

# =============================================================================
# REGISTRY CONFIGURATION
# =============================================================================
# Use npm registry for public packages
registry=https://registry.npmjs.org/

# =============================================================================
# PNPM CONFIGURATION
# =============================================================================
# Enable strict peer dependencies
strict-peer-dependencies=false

# Auto install peer dependencies
auto-install-peers=true

# Enable side effects cache
side-effects-cache=false

# Store location — left empty for cross-platform compatibility (Windows + Vercel Linux CI)
# store-dir=C:\.pnpm-store  <-- disabled: Windows path breaks Vercel build

# Use hoisted node-linker to avoid duplicates
node-linker=hoisted

# Deduplicate dependencies
dedupe-peer-dependents=true

# =============================================================================
# SECURITY
# =============================================================================
# Audit level
audit-level=moderate

# Fund messages
fund=false

# =============================================================================
# PERFORMANCE
# =============================================================================
# Prefer offline disabled — breaks Vercel/CI environments
# prefer-offline=true

# Cache configuration
cache-min=86400

# =============================================================================
# ENTERPRISE
# =============================================================================
# Save versions with caret (allow minor updates)
save-exact=false
save-prefix=^

# Enable package lock
package-lock=true

# =============================================================================
# WORKSPACE
# =============================================================================
# Enable workspaces
workspace-concurrency=4

# =============================================================================
# LOGGING
# =============================================================================
# Log level
loglevel=warn

# =============================================================================
# NETWORK
# =============================================================================
# Timeout
timeout=300000

# Retry configuration
fetch-retries=3
fetch-retry-factor=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
