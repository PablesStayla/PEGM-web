{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "echo \"🚀 Absolute Zero session started at $(date)\"",
        "powershell": "Write-Host \"🚀 Absolute Zero session started at $(Get-Date)\"",
        "cwd": "."
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "echo \"🔍 Checking prompt compliance...\"",
        "powershell": "Write-Host \"🔍 Checking prompt compliance...\"",
        "cwd": "."
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "echo \"🛡️ Validating tool execution safety...\"",
        "powershell": "Write-Host \"🛡️ Validating tool execution safety...\"",
        "cwd": "."
      }
    ]
  }
}
