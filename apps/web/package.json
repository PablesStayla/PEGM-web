{
  "name": "@pranakaia/web",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "PranaKaia GrowShop — Tienda de cultivo indoor, hidroponía e iluminación",
  "author": "PranaKaia Team",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "pnpm -w exec biome check apps/web",
    "lint:fix": "pnpm -w exec biome check --write apps/web",
    "format": "pnpm -w exec biome format --write apps/web",
    "format:check": "pnpm -w exec biome format apps/web",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "analyze": "ANALYZE=true pnpm -w exec next build apps/web",
    "clean": "rimraf .next .turbo node_modules/.cache",
    "clean:deep": "rm -rf .next node_modules && pnpm install",
    "test:coverage": "node ../../node_modules/vitest/vitest.mjs --config ../../vitest.config.ts run --coverage",
    "test:unit": "node ../../node_modules/vitest/vitest.mjs --config ../../vitest.config.ts run",
    "test:vitest": "node ../../node_modules/vitest/vitest.mjs --config ../../vitest.config.ts run",
    "test:watch": "node ../../node_modules/vitest/vitest.mjs --config ../../vitest.config.ts --watch",
    "test:e2e": "playwright test --config ../../config/playwright.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@marsidev/react-turnstile": "^1.4.2",
    "@pranakaia/ui": "workspace:*",
    "@react-email/components": "^1.0.8",
    "@sentry/nextjs": "^10.45.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.4",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^11.15.0",
    "inngest": "^3.52.6",
    "lucide-react": "^0.577.0",
    "next": "^15.2.3",
    "next-intl": "^4.8.3",
    "next-themes": "^0.4.6",
    "nuqs": "^2.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.72.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.8.0",
    "resend": "^6.9.4",
    "stripe": "^17.4.0",
    "tailwindcss": "^4.2.2",
    "zod": "^3.24.2",
    "zustand": "^5.0.12",
    "@pranakaia/checkout": "workspace:*",
    "@pranakaia/inventory": "workspace:*",
    "@pranakaia/catalog": "workspace:*",
    "@pranakaia/infrastructure": "workspace:*",
    "@pranakaia/shared-kernel": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/ui": "^4.1.0",
    "autoprefixer": "^10.4.27",
    "jsdom": "^28.1.0",
    "typescript": "5.6.3",
    "vitest": "^4.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "msw": {
    "workerDirectory": "public"
  }
}
