{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/lib/*": ["./src/lib/*", "../../packages/ui/src/lib/*"],
      "@/i18n/*": ["../../packages/ui/src/i18n/*"],
      "@pranakaia/ui": ["../../packages/ui/src"],
      "@pranakaia/ui/*": ["../../packages/ui/src/*"],
      "@pranakaia/ui/tailwind.config": ["../../packages/ui/tailwind.config.ts"],
      "@pranakaia/infrastructure": ["../../packages/infrastructure/src"],
      "@pranakaia/infrastructure/db": ["../../packages/infrastructure/src/db/index.ts"],
      "@pranakaia/infrastructure/*": ["../../packages/infrastructure/src/*"],
      "@pranakaia/auth/*": ["../../packages/infrastructure/src/auth/*"],
      "@pranakaia/shared-kernel": ["../../packages/shared-kernel/src"],
      "@pranakaia/shared-kernel/*": ["../../packages/shared-kernel/src/*"],
      "@pranakaia/domain": ["../../packages/domain/src"],
      "@pranakaia/domain/*": ["../../packages/domain/src/*"],
      "@pranakaia/cart": ["../../packages/cart/src"],
      "@pranakaia/cart/*": ["../../packages/cart/src/*"],
      "@pranakaia/catalog": ["../../packages/catalog/src"],
      "@pranakaia/catalog/*": ["../../packages/catalog/src/*"],
      "@pranakaia/checkout": ["../../packages/checkout/src"],
      "@pranakaia/checkout/*": ["../../packages/checkout/src/*"],
      "@pranakaia/payments": ["../../packages/payments/src"],
      "@pranakaia/payments/*": ["../../packages/payments/src/*"],
      "@pranakaia/inventory": ["../../packages/inventory/src"],
      "@pranakaia/inventory/*": ["../../packages/inventory/src/*"],
      "@pranakaia/pricing": ["../../packages/pricing/src"],
      "@pranakaia/pricing/*": ["../../packages/pricing/src/*"],
      "@pranakaia/shipping": ["../../packages/shipping/src"],
      "@pranakaia/shipping/*": ["../../packages/shipping/src/*"],
      "@pranakaia/supplier": ["../../packages/supplier/src"],
      "@pranakaia/supplier/*": ["../../packages/supplier/src/*"],
      "@pranakaia/logistics": ["../../packages/logistics/src"],
      "@pranakaia/logistics/*": ["../../packages/logistics/src/*"],
      "@pranakaia/communications": ["../../packages/communications/src"],
      "@pranakaia/communications/*": ["../../packages/communications/src/*"],
      "@pranakaia/identity": ["../../packages/identity/src"],
      "@pranakaia/identity/*": ["../../packages/identity/src/*"]
    },
    "types": ["node"],
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "jsx": "preserve",
    "skipLibCheck": true,
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "allowJs": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/*/src/**/*",
    "../../packages/ui/tailwind.config.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/__tests__/**",
    "../../packages/**/*.test.*",
    "../../packages/**/*.spec.*"
  ]
}
