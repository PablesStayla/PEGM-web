{
  "name": "@pranakaia/admin",
  "version": "1.0.0",
  "description": "Pranakaia Admin Backoffice - Next.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "pnpm -w exec biome check apps/admin",
    "lint:fix": "pnpm -w exec biome check --write apps/admin",
    "format": "pnpm -w exec biome format --write apps/admin",
    "clean": "rimraf .next .turbo node_modules",
    "type-check": "tsc -p ./tsconfig.json --noEmit",
    "test": "vitest run",
    "test:vitest": "vitest run"
  },
  "dependencies": {
    "@casl/ability": "^6.8.1",
    "@casl/react": "^6.0.0",
    "@hookform/resolvers": "^3.10.0",
    "@pranakaia/catalog": "workspace:*",
    "@pranakaia/inventory": "workspace:*",
    "@pranakaia/pricing": "workspace:*",
    "@pranakaia/shared-kernel": "workspace:*",
    "@pranakaia/ui": "workspace:*",
    "@sentry/nextjs": "^10.45.0",
    "cloudinary": "^2.9.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.577.0",
    "next": "^15.2.3",
    "next-safe-action": "^7.10.4",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^3.8.0",
    "tailwindcss": "^4.2.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.4.27",
    "jsdom": "^28.1.0",
    "typescript": "5.6.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5"
  }
}
