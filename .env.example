# ==============================================================
# Sitio personal — variables de entorno
# ==============================================================

# Secreto para firmar las sesiones del panel de administración.
# Generar uno con: openssl rand -hex 32
AUTH_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# Credenciales del administrador.
# Solo se usan la PRIMERA vez que se crea la base de datos (semilla).
# Para cambiar la contraseña después, usar Panel → Ajustes.
ADMIN_EMAIL="admin@pablo.cl"
ADMIN_PASSWORD="admin1234"

# --------------------------------------------------------------
# Base de datos Turso (producción / serverless)
# Sin estas variables, el sitio usa SQLite local (data/site.db).
#
#   npm i -g @turso/cli
#   turso auth signup            # crear cuenta (free tier generoso)
#   turso db create pablo-site   # crear la base
#   turso db show pablo-site --url          → TURSO_DATABASE_URL
#   turso db tokens create pablo-site       → TURSO_AUTH_TOKEN
#
# En Vercel: definir estas variables + AUTH_SECRET y ADMIN_*.
# El primer arranque aplica migraciones y siembra el contenido.
# --------------------------------------------------------------
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
