# ==============================================================================
# 🚀 PRANAKAIA E-COMMERCE - GLOBAL ENVIRONMENT TEMPLATE
# ==============================================================================
# Role: Canonical Configuration Blueprint
# Tier: Absolute Zero (S+)
# Compliance: SOTA Infrastructure Taxonomy
# Last Updated: 2026-05-05
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="PranaKaia E-Commerce"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
NODE_ENV="development" # development | production | test
LOG_LEVEL="debug" # debug | info | warn | error

# ------------------------------------------------------------------------------
# 🐘 2. INFRASTRUCTURE & DATA PERSISTENCE
# ------------------------------------------------------------------------------
# --- PostgreSQL (Primary) ---
DATABASE_URL="postgresql://user:password@localhost:5432/db"
DIRECT_URL="postgresql://user:password@localhost:5432/db" # For migrations

# --- Supabase ---
SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

# --- Redis & Cache (Upstash) ---
UPSTASH_REDIS_REST_URL="https://your-project.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-rest-token"
REDIS_URL="rediss://default:password@your-project.upstash.io:6379"
QUEUE_REDIS_URL="rediss://default:password@your-project.upstash.io:6379"

# ------------------------------------------------------------------------------
# 🔐 3. AUTHENTICATION & SECURITY (Better Auth / NextAuth)
# ------------------------------------------------------------------------------
# --- Better Auth ---
BETTER_AUTH_SECRET="your-32-char-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# --- Common Auth Secrets (Required by Validator) ---
AUTH_SECRET="your-32-char-minimum-secret-here-!!!!!!!"
NEXTAUTH_SECRET="your-nextauth-secret"
JWT_SECRET="your-jwt-secret"
JWT_REFRESH_SECRET="your-jwt-refresh-secret"

# --- Encryption ---
ENCRYPTION_KEY="your-32-char-encryption-key"
CSRF_SECRET="your-32-char-csrf-secret"

# ------------------------------------------------------------------------------
# 💳 4. COMMERCE & PAYMENTS
# ------------------------------------------------------------------------------
# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Flow (Chile) ---
FLOW_API_KEY="your-flow-api-key"
FLOW_SECRET_KEY="your-flow-secret-key"
FLOW_SANDBOX="true"

# ------------------------------------------------------------------------------
# 📧 5. COMMUNICATIONS & NOTIFICATIONS
# ------------------------------------------------------------------------------
# --- Resend ---
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@pranakaia.com"

# ------------------------------------------------------------------------------
# 📊 6. OBSERVABILITY & MONITORING
# ------------------------------------------------------------------------------
# --- Sentry ---
SENTRY_DSN="https://...@o....ingest.sentry.io/..."
SENTRY_AUTH_TOKEN="sntryu_..."
SENTRY_ORG="pranakaia"
SENTRY_PROJECT="web"
SENTRY_ENVIRONMENT="development"

# ------------------------------------------------------------------------------
# 🤖 7. AI & MCP SERVICES
# ------------------------------------------------------------------------------
FIRECRAWL_API_KEY="fc-..."
CONTEXT7_API_KEY="ctx7sk-..."
FIGMA_ACCESS_TOKEN="figd_..."
CLOUDINARY_CLOUD_NAME="PranaKaia"
CLOUDINARY_API_KEY="..."
CLOUDINARY_API_SECRET="..."

# ------------------------------------------------------------------------------
# 📦 8. PLATFORM & DEPLOYMENT
# ------------------------------------------------------------------------------
# --- Vercel ---
VERCEL_TOKEN="vcp_..."
VERCEL_ORG_ID="team_..."
VERCEL_PROJECT_ID="prj_..."

# --- GitHub ---
GITHUB_TOKEN="ghp_..."
GITHUB_CLIENT_ID="your-client-id"
GITHUB_CLIENT_SECRET="your-client-secret"

# ------------------------------------------------------------------------------
# 🧪 9. DOCKER & INFRA (Optional)
# ------------------------------------------------------------------------------
PROMETHEUS_IMAGE_TAG="v2.54.1"
GRAFANA_IMAGE_TAG="11.2.2"
MINIO_IMAGE_TAG="RELEASE.2024-10-29T16-01-48Z"
POSTGRES_PASSWORD_FILE="./infra/docker/secrets/postgres_password.txt"
# ==============================================================================
