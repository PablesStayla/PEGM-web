{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.local", "pnpm-workspace.yaml"],
  "globalEnv": ["NODE_ENV", "VERCEL", "VERCEL_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "DIRECT_URL",
        "POSTGRES_URL",
        "POSTGRES_URL_NON_POOLING",
        "POSTGRES_USER",
        "POSTGRES_HOST",
        "POSTGRES_PASSWORD",
        "POSTGRES_DATABASE",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "SUPABASE_URL",
        "SUPABASE_ANON_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "SUPABASE_SECRET_KEY",
        "SUPABASE_JWT_SECRET",
        "SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NEXTAUTH_SECRET",
        "NEXTAUTH_URL",
        "AUTH_SECRET",
        "JWT_SECRET",
        "JWT_REFRESH_SECRET",
        "JWT_EXPIRES_IN",
        "JWT_REFRESH_EXPIRES_IN",
        "REDIS_URL",
        "REDIS_PASSWORD",
        "REDIS_DB",
        "REDIS_TTL",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "KV_URL",
        "KV_REST_API_TOKEN",
        "KV_REST_API_URL",
        "KV_REST_API_READ_ONLY_TOKEN",
        "STRIPE_SECRET_KEY",
        "STRIPE_PUBLIC_KEY",
        "STRIPE_PUBLISHABLE_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "STRIPE_API_VERSION",
        "STRIPE_MCP_KEY",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_PAYMENT_GATEWAY",
        "FLOW_API_KEY",
        "FLOW_SECRET_KEY",
        "FLOW_SANDBOX",
        "RESEND_API_KEY",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_USER",
        "SMTP_PASS",
        "CLOUDINARY_CLOUD_NAME",
        "CLOUDINARY_API_KEY",
        "CLOUDINARY_API_SECRET",
        "CLOUDINARY_UPLOAD_PRESET",
        "SENTRY_DSN",
        "SENTRY_AUTH_TOKEN",
        "ALGOLIA_APP_ID",
        "ALGOLIA_API_KEY",
        "ALGOLIA_SEARCH_KEY",
        "OPENAI_API_KEY",
        "SLACK_BOT_TOKEN",
        "ENVIAME_API_KEY",
        "STARKEN_API_KEY",
        "GOOGLE_ANALYTICS_ID",
        "VERCEL_ANALYTICS_ID",
        "ENABLE_ANALYTICS",
        "ENABLE_DEBUG",
        "ENABLE_DEBUG_MODE",
        "ENABLE_MAINTENANCE",
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY",
        "TURNSTILE_SECRET_KEY",
        "NEXT_PUBLIC_APP_URL",
        "APP_URL",
        "ADMIN_URL",
        "API_URL",
        "BCRYPT_ROUNDS",
        "RATE_LIMIT_MAX",
        "RATE_LIMIT_WINDOW",
        "BRAVE_API_KEY",
        "CLOUDFLARE_API_TOKEN",
        "MEILISEARCH_URL",
        "MEILISEARCH_API_KEY",
        "PORT",
        "ADMIN_PORT",
        "API_PORT",
        "WORKER_PORT",
        "COACH_PORT",
        "QUEUE_REDIS_URL",
        "QUEUE_CONCURRENCY",
        "ENABLE_GRAPHQL_PLAYGROUND",
        "ENABLE_API_DOCS",
        "ADMIN_STEP_UP_SECRET",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_APP_VERSION",
        "NEXT_PUBLIC_APP_NAME",
        "SUPPLIER_SECRETS_KEY",
        "CRON_SECRET",
        "ENABLE_LOCAL_ADMIN_BYPASS",
        "LOG_LEVEL",
        "SERVICE_NAME",
        "EMAIL_AUTH_ENABLED"
      ]
    },
    "@pranakaia/db#build": {
      "outputs": []
    },
    "@pranakaia/testkit#build": {
      "outputs": []
    },
    "@pranakaia/email#build": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": [],
      "cache": true
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**"],
      "cache": false
    },
    "test:vitest": {
      "dependsOn": [],
      "outputs": ["coverage/**"],
      "cache": true
    },
    "test:unit": {
      "dependsOn": [],
      "outputs": ["coverage/**"],
      "cache": true
    },
    "type-check": {
      "outputs": []
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "admin:dev": {
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "outputs": ["coverage/**"],
      "cache": true
    },
    "clean": {
      "cache": false
    }
  }
}
