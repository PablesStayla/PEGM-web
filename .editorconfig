# 📝 PranaKaia Global Editor Configuration
# Role: IDE Consistency & Code Style Standardization
# Tier: Absolute Zero (S+)
# Compliance: SOTA Absolute Zero Taxonomy
# Last Updated: 2026-05-05

root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{json,json5}]
indent_size = 2

[*.{ts,tsx,js,jsx}]
indent_style = space
indent_size = 2

[*.{sh,bash}]
end_of_line = lf

[*.bat]
end_of_line = crlf

[*.ps1]
end_of_line = lf

# Binary files
[*.{png,jpg,jpeg,gif,webp,ico,pdf,zip,gz,tar}]
insert_final_newline = false
trim_trailing_whitespace = false