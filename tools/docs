import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

/**
 * 📚 PranaKaia Documentation Validator (Staff Level)
 * 
 * Validates all markdown documentation against SOTA standards:
 * - File naming conventions (UPPERCASE, kebab-case, or numeric ADR style)
 * - Required sections (Overview, Purpose, Implementation)
 * - Link integrity (Internal & Absolute)
 * - Metadata (frontmatter with owner, last_updated, version)
 * - Staleness detection (90 days)
 * - Command verification (pnpm scripts existence)
 */

const STANDARDS = {
  fileNamePattern: /^([A-Z][A-Z0-9_-]*\.md|README\.md|[a-z0-9]+(?:-[a-z0-9]+)*\.md|[0-9]{3}-[a-z0-9]+(?:-[a-z0-9]+)*\.md)$/,
  requiredSections: ['overview', 'purpose'],
  forbiddenPatterns: [/TODO:/g, /FIXME:/g, /XXX:/g, /\[TBD\]/gi, /\[Coming Soon\]/gi],
  minContentLength: 200,
  maxDaysSinceUpdate: 90,
  ignoreDirs: ['node_modules', '.git', '.turbo', 'dist', 'coverage'],
};

const colors = {
  reset: '\x1b[0m',
  red: '\x1b[31m',
  green: '\x1b[32m',
  yellow: '\x1b[33m',
  blue: '\x1b[34m',
  magenta: '\x1b[35m',
  cyan: '\x1b[36m',
};

class DocValidator {
  private errors: string[] = [];
  private warnings: string[] = [];
  private stats = { total: 0, valid: 0, warnings: 0 };
  private packageScripts: string[] = [];

  constructor() {
    this.loadPackageScripts();
  }

  private loadPackageScripts() {
    try {
      const pkg = JSON.parse(fs.readFileSync('package.json', 'utf8'));
      this.packageScripts = Object.keys(pkg.scripts || {});
    } catch {
      console.warn(`${colors.yellow}⚠️  Warning: Could not load package.json scripts.${colors.reset}`);
    }
  }

  public async validate(targetDir: string) {
    const files = this.getMdFiles(targetDir);
    console.log(`${colors.cyan}🔍 Auditing ${files.length} documentation files...${colors.reset}\n`);

    for (const file of files) {
      this.validateFile(file);
    }

    this.printReport();
    return this.errors.length === 0;
  }

  private getMdFiles(dir: string, fileList: string[] = []): string[] {
    const items = fs.readdirSync(dir);
    for (const item of items) {
      if (STANDARDS.ignoreDirs.includes(item) || item.startsWith('.')) continue;
      const fullPath = path.join(dir, item);
      if (fs.statSync(fullPath).isDirectory()) {
        this.getMdFiles(fullPath, fileList);
      } else if (item.endsWith('.md')) {
        fileList.push(fullPath);
      }
    }
    return fileList;
  }

  private validateFile(filePath: string) {
    this.stats.total++;
    const fileName = path.basename(filePath);
    const content = fs.readFileSync(filePath, 'utf8');
    const relativePath = path.relative(process.cwd(), filePath);
    let hasFileError = false;

    console.log(`${colors.blue}📄 ${relativePath}${colors.reset}`);

    // 1. Naming
    if (!STANDARDS.fileNamePattern.test(fileName)) {
      this.addError(relativePath, `Naming convention violated: ${fileName}`);
      hasFileError = true;
    }

    // 2. Frontmatter / Metadata
    const hasFrontmatter = content.trim().startsWith('---');
    if (!hasFrontmatter) {
      this.addWarning(relativePath, 'Missing YAML frontmatter metadata');
    } else {
      this.validateFrontmatter(content, relativePath);
    }

    // 3. Sections
    const lowerContent = content.toLowerCase();
    for (const section of STANDARDS.requiredSections) {
      if (!new RegExp(`^#+\\s+${section}`, 'mi').test(lowerContent)) {
        this.addWarning(relativePath, `Missing recommended section: ${section}`);
      }
    }

    // 4. Forbidden patterns
    for (const pattern of STANDARDS.forbiddenPatterns) {
      if (pattern.test(content)) {
        this.addError(relativePath, `Forbidden pattern found: ${pattern}`);
        hasFileError = true;
      }
    }

    // 5. Link integrity
    this.validateLinks(content, filePath, relativePath);

    // 6. Commands
    this.validateCommands(content, relativePath);

    if (hasFileError) {
      console.log(`  ${colors.red}✗ FAILED${colors.reset}`);
    } else {
      this.stats.valid++;
      console.log(`  ${colors.green}✓ PASSED${colors.reset}`);
    }
  }

  private validateFrontmatter(content: string, filePath: string) {
    const match = content.match(/^---\s*([\s\S]*?)\s*---/);
    if (!match) return;
    const yaml = match[1];
    
    const dateMatch = yaml.match(/last_updated:\s*(\d{4}-\d{2}-\d{2})/);
    if (!dateMatch) {
      this.addWarning(filePath, 'Frontmatter missing last_updated: YYYY-MM-DD');
    } else {
      const lastUpdated = new Date(dateMatch[1]);
      const diff = (Date.now() - lastUpdated.getTime()) / (1000 * 60 * 60 * 24);
      if (diff > STANDARDS.maxDaysSinceUpdate) {
        this.addWarning(filePath, `Document is stale (${Math.floor(diff)} days old)`);
      }
    }

    if (!yaml.includes('owner:')) this.addWarning(filePath, 'Frontmatter missing owner');
    if (!yaml.includes('status:')) this.addWarning(filePath, 'Frontmatter missing status');
  }

  private validateLinks(content: string, filePath: string, relativePath: string) {
    const links = content.matchAll(/\[([^\]]+)\]\(([^)]+)\)/g);
    for (const [_, text, url] of links) {
      if (url.startsWith('./') || url.startsWith('../') || (!url.startsWith('http') && !url.startsWith('#') && !url.startsWith('mailto:'))) {
        const linkPath = path.resolve(path.dirname(filePath), url.split('#')[0]);
        if (!fs.existsSync(linkPath)) {
          this.addError(relativePath, `Broken internal link: ${url}`);
        }
      }
    }
  }

  private validateCommands(content: string, filePath: string) {
    const commands = content.matchAll(/`pnpm\s+([a-z0-9:-]+)(?:\s+[^`]*)?`/g);
    for (const [_, cmd] of commands) {
      if (!this.packageScripts.includes(cmd) && !['install', 'update', 'audit', 'exec', 'turbo', 'knip', 'supabase'].includes(cmd)) {
        this.addWarning(filePath, `Mentioned pnpm script "${cmd}" not found in package.json`);
      }
    }
  }

  private addError(path: string, msg: string) {
    this.errors.push(`[${path}] ${msg}`);
    console.log(`  ${colors.red}✗ ERROR:${colors.reset} ${msg}`);
  }

  private addWarning(path: string, msg: string) {
    this.warnings.push(`[${path}] ${msg}`);
    this.stats.warnings++;
    console.log(`  ${colors.yellow}⚠ WARN:${colors.reset} ${msg}`);
  }

  private printReport() {
    console.log(`\n${'='.repeat(60)}`);
    console.log(`${colors.cyan}📊 PRANAKAIA DOC AUDIT REPORT${colors.reset}`);
    console.log(`${'='.repeat(60)}`);
    console.log(`Files audited:  ${this.stats.total}`);
    console.log(`Valid:          ${colors.green}${this.stats.valid}${colors.reset}`);
    console.log(`Errors:         ${colors.red}${this.errors.length}${colors.reset}`);
    console.log(`Warnings:       ${colors.yellow}${this.stats.warnings}${colors.reset}`);
    console.log(`${'='.repeat(60)}\n`);

    if (this.errors.length > 0) {
      process.exit(1);
    }
  }
}

const dir = process.argv[2] || '.';
new DocValidator().validate(dir).catch(err => {
  console.error(err);
  process.exit(1);
});
