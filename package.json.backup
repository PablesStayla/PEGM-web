{
    "name":  "@pranakaia/monorepo",
    "version":  "1.0.0",
    "description":  "Enterprise-grade E-Commerce Monorepo for the PranaKaia Ecosystem. High-performance, DDD-driven architecture with Next.js 15, Drizzle ORM, and Supabase.",
    "author":  "Pablo \u003cpablo@pranakaia.cl\u003e (Architect), Antigravity Agent (Lead AI Engineer)",
    "license":  "MIT",
    "_metadata":  {
                      "project":  "PranaKaia E-Commerce",
                      "role":  "Workspace Root",
                      "tier":  "Absolute Zero (S+)",
                      "compliance":  "SOTA Absolute Zero",
                      "icons":  {
                                    "apps":  "ðŸ“±",
                                    "packages":  "ðŸ“¦",
                                    "tools":  "ðŸ› ï¸",
                                    "docs":  "ðŸ“š"
                                }
                  },
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/PablesStayla/PranaKaia-Ecommerce.git"
                   },
    "private":  true,
    "workspaces":  [
                       "apps/*",
                       "packages/*"
                   ],
    "scripts":  {
                    "build":  "turbo build",
                    "dev":  "turbo dev --concurrency 20",
                    "lint":  "turbo lint",
                    "lint:fix":  "pnpm exec biome check --write .",
                    "test":  "turbo test",
                    "test:unit":  "turbo test:vitest",
                    "test:e2e":  "turbo test:e2e",
                    "test:notion-sync":  "pnpm exec vitest run --config tools/vitest.config.ts",
                    "test:e2e:critical":  "pnpm exec playwright test --config tests/e2e/playwright.config.ts tests/e2e/flows/checkout.spec.ts tests/e2e/flows/admin-inventory.spec.ts",
                    "test:e2e:checkout":  "pnpm exec playwright test --config tests/e2e/playwright.config.ts tests/e2e/flows/checkout.spec.ts",
                    "test:e2e:admin":  "pnpm exec playwright test --config tests/e2e/playwright.config.ts tests/e2e/flows/admin-inventory.spec.ts",
                    "test:e2e:supplier":  "pnpm exec playwright test --config tests/e2e/playwright.config.ts tests/e2e/flows/supplier-onboarding.spec.ts",
                    "test:integration":  "pnpm exec vitest run tests/integration/",
                    "test:smoke":  "pnpm exec playwright test tests/smoke/health-check.spec.ts",
                    "test:security":  "pnpm exec playwright test tests/security/owasp-top10.spec.ts",
                    "test:ci":  "turbo test:vitest",
                    "test:mutation:critical":  "pnpm -w exec stryker run packages/config/stryker.critical.config.ts",
                    "quality:strict":  "pnpm -w lint \u0026\u0026 pnpm -w type-check \u0026\u0026 pnpm turbo run test --force",
                    "version":  "changeset version",
                    "version:check":  "changeset status",
                    "release":  "changeset publish",
                    "release:check":  "pnpm build \u0026\u0026 pnpm packages:attw \u0026\u0026 pnpm packages:publint",
                    "size-limit":  "size-limit",
                    "size-limit:json":  "size-limit --json",
                    "test:coverage":  "turbo test:coverage",
                    "coverage:critical:check":  "pnpm --filter @pranakaia/core-domain test:coverage \u0026\u0026 tsx tools/quality/critical-coverage-check.ts --coverage=coverage/core-domain/coverage-final.json",
                    "coverage:apps:critical:check":  "tsx tools/quality/apps-critical-coverage-check.ts --coverage=coverage/apps-web/coverage-final.json",
                    "test:coverage:analyze":  "tsx tools/ops/clean.ts",
                    "archi:check":  "depcruise --config .dependency-cruiser.ts .",
                    "type-check":  "turbo type-check",
                    "format":  "pnpm exec biome format --write .",
                    "clean":  "turbo clean",
                    "upgrade":  "pwsh -File ./tools/ops/upgrade-dependencies.ps1",
                    "upgrade:dry":  "pwsh -File ./tools/ops/upgrade-dependencies.ps1 -DryRun",
                    "deps:check":  "tsx tools/ops/dependencies-check.ts",
                    "deps:update":  "pnpm update --latest --recursive",
                    "dev:web":  "turbo dev --filter=@pranakaia/web --concurrency 20",
                    "dev:admin":  "turbo dev --filter=@pranakaia/admin --concurrency 20",
                    "security:audit":  "tsx tools/quality/security-triage.ts",
                    "security:audit:raw":  "pnpm audit",
                    "security:secrets:check":  "tsx tools/security/audit-secrets.ts",
                    "security:automation:check":  "tsx tools/quality/security-triage.ts",
                    "security:bug-bounty:check":  "tsx tools/quality/bug-bounty-operational-check.ts",
                    "security:lodash:watch":  "tsx tools/security/lodash-upstream-check.ts",
                    "security:lodash:apply":  "tsx tools/security/lodash-upstream-check.ts --apply",
                    "db:backup":  "tsx tools/ops/database/backup-restore.ts backup",
                    "db:restore":  "tsx tools/ops/database/backup-restore.ts restore",
                    "db:list":  "tsx tools/ops/database/backup-restore.ts list",
                    "db:verify":  "tsx tools/ops/database/backup-restore.ts verify",
                    "check-env":  "tsx tools/core/env-validator.ts",
                    "env:validate":  "tsx tools/core/env-validator.ts",
                    "env:validate:local":  "tsx tools/core/env-validator.ts local",
                    "env:validate:sandbox":  "tsx tools/core/env-validator.ts sandbox",
                    "env:validate:production":  "tsx tools/core/env-validator.ts production",
                    "agents:validate":  "tsx tools/docs/validate.ts",
                    "agents:meta:validate":  "tsx tools/ai/agent-validator.ts",
                    "staff:audit":  "tsx tools/quality/staff-audit.ts --report",
                    "staff:audit:strict":  "tsx tools/quality/staff-audit.ts --strict --report",
                    "tools:audit":  "tsx tools/audit/tools-audit.ts",
                    "tools:audit:check":  "tsx tools/audit/tools-audit.ts",
                    "staff:ready":  "pnpm -w lint \u0026\u0026 pnpm -w archi:check \u0026\u0026 pnpm -w staff:audit:strict \u0026\u0026 pnpm -w type-check \u0026\u0026 pnpm -w test:unit \u0026\u0026 pnpm -w build",
                    "staff:ready:extended":  "pnpm -w staff:ready \u0026\u0026 pnpm -w security:audit",
                    "project:validate":  "tsx tools/quality/foundation-audit.ts",
                    "docs:lint":  "tsx tools/quality/docs-lint.ts",
                    "docs:playground:api":  "pnpm dlx @redocly/cli preview-docs contracts/openapi/api.yaml --port 8090",
                    "docs:playground:web-critical":  "pnpm dlx @redocly/cli preview-docs contracts/openapi/web-critical.yaml --port 8091",
                    "k8s:gitops:check":  "tsx tools/quality/k8s-gitops-check.ts",
                    "dr:drill:check":  "tsx tools/quality/dr-drill-check.ts",
                    "dr:drill:evidence:check":  "tsx tools/quality/dr-drill-evidence-check.ts",
                    "analyze:bundle:web":  "pnpm --filter @pranakaia/web analyze",
                    "load:test":  "k6 run tests/load/k6/checkout-load.js",
                    "load:spike":  "k6 run tests/load/k6/spike-test.js",
                    "load:catalog":  "k6 run tests/load/scenarios/catalog-browse.js",
                    "dx:doctor":  "tsx tools/dev/doctor.ts",
                    "dx:screenshots":  "tsx tools/dev/take-screenshots.ts",
                    "dx:fix":  "pnpm install \u0026\u0026 pnpm exec lefthook install \u0026\u0026 echo \u0027Environment fixed!\u0027",
                    "repo:clean":  "tsx tools/ops/clean.ts",
                    "audit:closure:m6":  "tsx tools/quality/roadmap-m6-closure-check.ts",
                    "world-class:audit":  "pnpm staff:audit:strict \u0026\u0026 pnpm world-class:performance \u0026\u0026 pnpm world-class:metrics \u0026\u0026 pnpm world-class:a11y \u0026\u0026 pnpm world-class:sast",
                    "world-class:performance":  "tsx tools/quality/bundle-budget.ts",
                    "world-class:metrics":  "tsx tools/metrics/dora-calculator.ts",
                    "world-class:a11y":  "tsx tools/quality/accessibility-budget.ts",
                    "world-class:sast":  "tsx tools/quality/sast-scanner.ts",
                    "packages:validate":  "tsx tools/quality/validate-packages.ts",
                    "packages:attw":  "pnpm --filter @pranakaia/* attw",
                    "packages:publint":  "pnpm --filter @pranakaia/* publint",
                    "packages:size":  "size-limit",
                    "packages:exports:validate":  "tsx tools/quality/validate-packages-exports.ts",
                    "packages:audit":  "tsx tools/quality/audit-packages.ts",
                    "docs:typedoc":  "typedoc --options .typedoc.json",
                    "knip":  "knip --config .knip.ts",
                    "changeset":  "changeset",
                    "changeset:version":  "changeset version",
                    "changeset:publish":  "changeset publish"
                },
    "devDependencies":  {
                            "@axe-core/playwright":  "^4.11.1",
                            "@biomejs/biome":  "^2.4.8",
                            "@stryker-mutator/core":  "^9.6.0",
                            "@testing-library/user-event":  "^14.6.1",
                            "@types/node":  "^24.0.0",
                            "@upstash/redis":  "^1.36.4",
                            "dependency-cruiser":  "^17.3.10",
                            "fast-check":  "^4.7.0",
                            "knip":  "^5.85.0",
                            "lefthook":  "^2.1.4",
                            "rimraf":  "^6.1.3",
                            "supabase":  "^2.84.5",
                            "turbo":  "^2.9.2",
                            "typescript":  "^5.9.3",
                            "vite":  "8.0.5",
                            "vite-tsconfig-paths":  "^6.1.1",
                            "vitest":  "^4.1.0",
                            "zod":  "^3.24.2",
                            "typedoc":  "^0.27.9",
                            "@arethetypeswrong/cli":  "^0.17.4",
                            "publint":  "^0.3.8",
                            "tsup":  "^8.4.0",
                            "@changesets/cli":  "^2.28.0",
                            "@size-limit/preset-app":  "^11.2.0",
                            "size-limit":  "^11.2.0"
                        },
    "overrides":  {
                      "@esbuild-kit/core-utils\u003eesbuild":  "0.25.12",
                      "@types/react":  "19.0.10",
                      "@types/react-dom":  "19.0.4",
                      "glob":  "^10.5.0",
                      "lodash":  "4.18.1",
                      "lodash-es":  "4.18.0",
                      "next":  "^15.2.3",
                      "react":  "19.0.0",
                      "react-dom":  "19.0.0",
                      "vite":  "\u003e=8.0.5"
                  },
    "engines":  {
                    "node":  "24.x",
                    "pnpm":  "10.x"
                },
    "packageManager":  "pnpm@10.33.0",
    "pnpm":  {
                 "overrides":  {
                                   "@esbuild-kit/core-utils\u003eesbuild":  "0.25.12",
                                   "glob":  "^10.5.0",
                                   "lodash":  "4.18.1",
                                   "lodash-es":  "4.18.0",
                                   "next":  "^15.2.3",
                                   "vite@\u003e=8.0.0 \u003c=8.0.4":  "\u003e=8.0.5"
                               },
                 "onlyBuiltDependencies":  [
                                               "@biomejs/biome",
                                               "@sentry/cli"
                                           ],
                 "peerDependencyRules":  {
                                             "ignoreMissing":  [
                                                                   "tailwindcss"
                                                               ],
                                             "allowAny":  [
                                                              "tailwindcss",
                                                              "react",
                                                              "react-dom"
                                                          ],
                                             "allowedVersions":  {
                                                                     "react":  "19",
                                                                     "react-dom":  "19"
                                                                 }
                                         }
             },
    "dependencies":  {
                         "@opentelemetry/api":  "^1.9.1"
                     }
}
