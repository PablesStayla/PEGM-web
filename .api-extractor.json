{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.json",
  "_metadata": {
    "project": "PranaKaia E-Commerce",
    "role": "API Documentation",
    "tier": "Absolute Zero (S+)",
    "compliance": "SOTA Absolute Zero"
  },
  "mainEntryPointFilePath": "<projectFolder>/dist/index.d.ts",
  "bundledPackages": [],
  "compiler": {
    "tsconfigFilePath": "<projectFolder>/tsconfig.json",
    "overrideTsconfig": {}
  },
  "apiReport": {
    "enabled": true,
    "reportFolder": "<projectFolder>/temp",
    "reportTempFolder": "<projectFolder>/temp/api-report"
  },
  "docModel": {
    "enabled": true,
    "apiJsonFilePath": "<projectFolder>/temp/<unscopedPackageName>.api.json"
  },
  "dtsRollup": {
    "enabled": true,
    "untrimmedFilePath": "<projectFolder>/dist/index.d.ts"
  },
  "tsdocMetadata": {
    "enabled": true
  },
  "messages": {
    "compilerMessageReporting": {
      "default": {
        "logLevel": "warning"
      }
    },
    "extractorMessageReporting": {
      "default": {
        "logLevel": "warning"
      },
      "ae-missing-release-tag": {
        "logLevel": "none"
      }
    },
    "tsdocMessageReporting": {
      "default": {
        "logLevel": "warning"
      }
    }
  }
}
