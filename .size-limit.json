{
  "$schema": "https://size-limit.github.io/v8.0.0/",
  "_metadata": {
    "project": "PranaKaia E-Commerce",
    "role": "Bundle Size Guard",
    "tier": "Absolute Zero (S+)",
    "compliance": "SOTA Absolute Zero"
  },
  "presets": ["@size-limit/preset-app"],
  "limits": [
    {
      "path": "packages/shared-kernel/dist/index.mjs",
      "limit": "5 KB",
      "gzip": true
    },
    {
      "path": "packages/cart/dist/index.mjs",
      "limit": "15 KB",
      "gzip": true
    },
    {
      "path": "packages/catalog/dist/index.mjs",
      "limit": "20 KB",
      "gzip": true
    },
    {
      "path": "packages/checkout/dist/index.mjs",
      "limit": "25 KB",
      "gzip": true
    },
    {
      "path": "packages/inventory/dist/index.mjs",
      "limit": "15 KB",
      "gzip": true
    },
    {
      "path": "packages/pricing/dist/index.mjs",
      "limit": "10 KB",
      "gzip": true
    },
    {
      "path": "packages/payments/dist/index.mjs",
      "limit": "18 KB",
      "gzip": true
    },
    {
      "path": "packages/shipping/dist/index.mjs",
      "limit": "12 KB",
      "gzip": true
    },
    {
      "path": "packages/supplier/dist/index.mjs",
      "limit": "10 KB",
      "gzip": true
    },
    {
      "path": "packages/logistics/dist/index.mjs",
      "limit": "12 KB",
      "gzip": true
    },
    {
      "path": "packages/communications/dist/index.mjs",
      "limit": "8 KB",
      "gzip": true
    },
    {
      "path": "packages/identity/dist/index.mjs",
      "limit": "20 KB",
      "gzip": true
    },
    {
      "path": "packages/application/dist/index.mjs",
      "limit": "30 KB",
      "gzip": true
    },
    {
      "path": "packages/infrastructure/dist/index.mjs",
      "limit": "25 KB",
      "gzip": true
    },
    {
      "path": "packages/testkit/dist/index.mjs",
      "limit": "15 KB",
      "gzip": true
    },
    {
      "path": "packages/ui/dist/index.mjs",
      "limit": "50 KB",
      "gzip": true
    }
  ]
}
