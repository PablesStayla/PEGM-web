    "overrides": {
      "zod": "^3.23.0",
      "typescript": "5.6.3",
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "glob": "^10.5.0",
      "lodash": "4.18.1",
      "lodash-es": "4.18.0",
      "next": "^15.2.3",
      "vite": ">=6.0.5"
    },
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@sentry/cli"
    ],
    "peerDependencyRules": {
      "ignoreMissing": [
        "tailwindcss"
