    "performance:web": "pnpm --filter @pranakaia/web analyze",
    "compliance:performance": "tsx tools/quality-assurance/check-bundle-budget.ts",
    "architecture:validate": "tsx tools/quality-assurance/validate-architecture-shield.ts",
