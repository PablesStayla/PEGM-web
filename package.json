    "build:all": "turbo build --force",
    "environment:validate:prod": "tsx tools/foundation/validate-env-schema.ts production",
    "performance:budget": "tsx tools/quality-assurance/check-bundle-budget.ts",
    "typecheck:all": "turbo type-check --force",
    "compliance:full:metrics": "tsx tools/telemetry/calculate-dora-report.ts",
