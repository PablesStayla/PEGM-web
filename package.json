    "dev:web": "turbo dev --filter=@pranakaia/web",
    "clean": "turbo clean",
    "build:web": "turbo build --filter=@pranakaia/web",
    "test:e2e:critical": "playwright test tests/e2e/flows/{checkout,admin-inventory}.spec.ts",
    "architecture:exports": "tsx tools/quality-assurance/validate-packages-exports.ts",
    "environment:validate": "tsx tools/foundation/validate-env-schema.ts",
    "developer:clean": "tsx tools/operations/clean-artifacts-build.ts",
    "quality:strict": "pnpm lint && pnpm typecheck && pnpm test:unit",
    "tree": "tree -l 4 --ignore 'node_modules,dist,.git,.turbo,coverage,playwright-report,test-results,arbol.txt'"
  },
  "devDependencies": {
