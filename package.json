{
  "name": "pegm-web",
  "version": "2.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "description": "Sitio web personal de Pablo — Ingeniero Civil Metalúrgico (panel admin, laboratorio interactivo, DB Turso/libSQL, stack SOTA)",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src scripts tests",
    "lint:fix": "biome check --write src scripts tests",
    "format": "biome format --write src scripts tests",
    "check:agents": "node scripts/agents-check.mjs",
    "docs:sync": "node scripts/docs-sync.mjs sync",
    "docs:check": "node scripts/docs-sync.mjs check",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:reset": "node scripts/reset-db.mjs",
    "test:e2e": "playwright test",
    "evals:run": "node scripts/evals/run.mjs",
    "evals:report": "node scripts/evals/run.mjs report",
    "cv:pdf": "node scripts/generate-public-cv.mjs",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.0",
    "@fontsource-variable/inter": "^5.2.0",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "lefthook": "^2.2.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
