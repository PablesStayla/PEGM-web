    "test:e2e:admin": "playwright test tests/e2e/flows/admin-inventory.spec.ts",
    "architecture:check": "depcruise --config .dependency-cruiser.ts .",
    "compliance:full:audit": "pnpm staff:audit:strict && pnpm worldclass:performance && pnpm worldclass:metrics && pnpm worldclass:a11y && pnpm worldclass:sast",
    "build": "turbo build",
    "compliance:a11y": "tsx tools/quality-assurance/check-accessibility-budget.ts",
    "docs:lint": "tsx tools/quality-assurance/lint-docs-style.ts",
    "dev:admin": "turbo dev --filter=@pranakaia/admin",
    "typecheck": "turbo type-check",
    "automation:meta": "tsx tools/automation/agent-validator.ts",
