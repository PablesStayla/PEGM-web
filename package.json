  "author": "Pablo <pablo@pranakaia.cl> (Architect), Antigravity Agent (Lead AI Engineer)",
  "license": "MIT",
  "_metadata": {
    "project": "PranaKaia E-Commerce",
    "role": "Workspace Root",
    "tier": "Absolute Zero (S+)",
